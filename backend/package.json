{
    "name": "startup-news-room-api",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.0.0"
    },
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "seed": "tsx src/scripts/seed.ts",
        "test": "vitest run",
        "lint": "eslint . --ext .ts",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "bcryptjs": "^2.4.3",
        "cheerio": "^1.0.0",
        "cloudinary": "^2.5.1",
        "compression": "^1.7.4",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^5.1.0",
        "express-rate-limit": "^7.4.1",
        "file-type": "^19.6.0",
        "helmet": "^8.0.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.8.0",
        "multer": "^1.4.5-lts.1",
        "nanoid": "^5.0.8",
        "pino": "^9.5.0",
        "pino-http": "^10.3.0",
        "sanitize-html": "^2.13.1",
        "slugify": "^1.6.6",
        "zod": "^3.23.8"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/compression": "^1.7.5",
        "@types/cookie-parser": "^1.4.7",
        "@types/cors": "^2.8.17",
        "@types/express": "^5.0.0",
        "@types/jsonwebtoken": "^9.0.7",
        "@types/multer": "^1.4.12",
        "@types/node": "^22.9.0",
        "@types/sanitize-html": "^2.13.0",
        "@types/supertest": "^6.0.2",
        "@typescript-eslint/eslint-plugin": "^8.13.0",
        "@typescript-eslint/parser": "^8.13.0",
        "eslint": "^9.14.0",
        "mongodb-memory-server": "^10.1.2",
        "supertest": "^7.0.0",
        "tsx": "^4.19.2",
        "typescript": "^5.6.3",
        "vitest": "^2.1.4"
    }
